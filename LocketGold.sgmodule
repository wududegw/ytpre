#!name=Locket Gold Premium
#!desc=Mở khóa gói Locket Gold Premium thành công 100%. Tự động cấu hình Giải mã HTTPS và Script.
#!category=Premium

[Script]
locket-gold = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^\/]+$), script-path=https://raw.githubusercontent.com/wududegw/ytpre/main/Module/js/revenuecat_multi.js, requires-body=1, max-size=0, timeout=60

[MITM]
enable = true
hostname = api.revenuecat.com, api.rc-backup.com
