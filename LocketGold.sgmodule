#!name=Locket Gold Premium
#!desc=Mở khóa gói Locket Gold Premium thành công 100%. Tự động cấu hình Giải mã HTTPS và Script.
#!category=Premium

[Script]
locket-gold = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^\/]+$), script-path=https://raw.githubusercontent.com/ekaznyra/NguyenNgocAnhTu/master/Module/js/revenuecat_multi.js, requires-body=1, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com
